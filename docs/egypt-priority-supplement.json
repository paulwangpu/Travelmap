  "capital": {
    "name": "卡塔伊",
    "enName": "al-Qata’i",
    "identity": "图伦王朝都城",
    "years": "9世纪后期—905年（王朝868—905年；建城时间另计）",
    "note": "图伦王朝都城，与福斯塔特、阿斯卡尔及969年建立的法蒂玛开罗分址。图伦王朝868—905年；本记录为9世纪后期至905年的都城阶段，不把王朝起年直接当作建城年。根点以伊本·图伦清真寺所在历史核心作区域参照；不是已确认王宫位置。现仅接入清真寺建筑外缘及庭院孔洞，不代表全城、宫城或城墙；完整分期城界和宫殿遗存范围待核。",
    "enNote": "Tulunid capital, distinct from Fustat, al-Askar and Fatimid Cairo founded in 969. The dynasty lasted 868–905; this record covers the late ninth-century capital phase to 905 without equating dynastic accession with city foundation. The root references the historic mosque core, not a verified royal palace. The mosque footprint and courtyard hole are preserved; they are not city, palace or wall boundaries. Complete dated city and palace limits remain unverified.",
    "sources": [
      "https://egymonuments.gov.eg/collections/historical-cairo/",
      "https://egymonuments.gov.eg/monuments/ahmad-ibn-tulun-mosque/"
    ],
    "completeCityBoundary": false,
    "completePalaceBoundary": false
  }
