  "sources": {
    "大梁": {
      "title": "开封党史方志网：战国时期魏国大梁城",
      "url": "https://www.kfdsw.com/index/detail/id/254.html",
      "note": "官方地方史明确：大梁城遗址尚未探明；城址地望与城界为研究推定。"
    },
    "开封": {
      "title": "北宋东京形制布局与前代沿革",
      "url": "https://img.dpm.org.cn/Uploads/File/2019/11/25/u5ddbb7e042505.pdf",
      "note": "后梁、后晋、后汉、后周的城址沿革分别保留记录。唐汴州旧城为宋里城基础，但宋图件不等于各期城墙实测；金期也不直接套完整北宋外郭。"
    },
    "杭州": {
      "title": "杭州市人大：南宋皇城大遗址保护调研",
      "url": "https://z.hangzhou.com.cn/2021/rddssbchy/content/content_8082761.html",
      "note": "吴越西府和南宋临安府按阶段保留；皇城、德寿宫和府治不同。杭州临安区衣锦城不代替杭州市区吴越西府。"
    },
    "安阳殷墟": {
      "title": "UNESCO：殷墟申遗文件及遗存分布图",
      "url": "https://whc.unesco.org/uploads/nominations/1114.pdf#page=197",
      "note": "区分晚商宫殿宗庙、王陵与更早洹北商城。申遗保护区、现代展示区和整个殷墟都邑不是同一范围；“相”与洹北商城的对应尚有争议。"
    },
    "邺城": {
      "title": "中国社会科学院：邺城国家考古遗址公园",
      "url": "https://www.cssn.cn/lsx/lsx_kgx/202302/t20230221_5589933.shtml",
      "note": "邺城在河北邯郸临漳；邺北城与东魏北齐邺南城分别识别，与河南安阳殷墟保持独立。"
    },
    "平城遗址": {
      "title": "平城区政府：平城遗址",
      "url": "https://www.pingcheng.gov.cn/pcqrmzfz/wmdt/202009/cae6a468831648afaa98662286b5667b.shtml",
      "note": "平城四至尚未完整确定；明堂、操场城建筑遗址等可定位，不直接用明代大同城墙代替北魏郭城。"
    },
    "西京大同": {
      "title": "大同市政府：历史文化名城保护规划解读",
      "url": "https://www.dt.gov.cn/dtszf/gsgg/201503/81b3b58715de46fea719e6b4089c17cd.shtml",
      "note": "大同为辽金西京，华严寺与善化寺保留辽金建筑；现寺院边界不能代表辽金完整城界。"
    },
    "成都": {
      "title": "成都考古遗存：东华门遗址",
      "url": "https://news.chengdu.cn/2022/1121/2306802.shtml?phone=yes",
      "note": "秦汉六朝、隋唐宋、五代宣华苑、明代蜀王府和清代贡院在同区域叠压；展示区不是每一时期城池或宫城的完整轮廓。古蜀开明中心、前后蜀子城、明蜀王府不能直接套同一宫城范围。"
    },
    "金沙遗址": {
      "title": "成都博物馆：古蜀文明",
      "url": "https://www.cdmuseum.com/wenhua/202011/1948.html",
      "note": "金沙为古蜀权力中心，遗址分布约5平方公里；此处接入博物馆展示范围，不能替代全部古蜀都邑分布范围。三星堆在广汉，不并入成都市区城址。"
    }
  },
